# ============================================================
# Client Frontend - Environment Variables (Vite)
# ============================================================

# URL Server Utama (Server A)
VITE_SERVER_A_URL=http://localhost:3001

# URL Server Cadangan / Fallback (Server B)
VITE_SERVER_B_URL=http://localhost:3002

# Kredensial untuk Autentikasi JWT ke Server B (Demo / Pengujian Fallback)
VITE_AUTH_USERNAME=admin
VITE_AUTH_PASSWORD=password123

# Timeout HTTP Request Axios (Milidetik)
# Menjamin server yang hang/macet akan memicu fallback dalam batas waktu toleransi
VITE_TIMEOUT_MS=3000
